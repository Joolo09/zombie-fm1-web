z_dm_state z_dm;
static voice dm_voice[16];
static uint32_t dm_count,dm_rng=0x7a64c812u,dm_wait[16],dm_period[16];
static uint16_t dm_keys;
static uint32_t dm_skip[16];
static uint8_t dm_left[16],dm_velocity[16];
static Z_POOL z_dm_state dm_undo[4],dm_redo[4];
static uint32_t dm_undo_count,dm_redo_count;
static uint32_t dm_random(void){uint32_t x=dm_rng;x^=x<<13;x^=x>>17;x^=x<<5;return dm_rng=x;}
static void dm_history_push(z_dm_state *bank,uint32_t *n){if(*n==4){for(uint32_t i=0;i<3;i++)bank[i]=bank[i+1];*n=3;}bank[(*n)++]=z_dm;}
static void dm_checkpoint(void){dm_history_push(dm_undo,&dm_undo_count);dm_redo_count=0;}
void z_dm_history_reset(void){dm_undo_count=dm_redo_count=0;}
uint32_t z_dm_history_state(void){return dm_undo_count|(dm_redo_count<<8);}
uint32_t z_dm_history(uint32_t redo){if(redo>1)return 0;z_record(0);z_dm_panic();uint8_t selected=z_dm.selected;if(redo){if(!dm_redo_count)return 0;dm_history_push(dm_undo,&dm_undo_count);z_dm=dm_redo[--dm_redo_count];}else{if(!dm_undo_count)return 0;dm_history_push(dm_redo,&dm_redo_count);z_dm=dm_undo[--dm_undo_count];}z_dm.selected=selected;z_touch();return 1;}
int z_dm_valid(const z_dm_state *s){if(s->magic!=Z_DM_MAGIC||s->version!=1||s->selected>=16||s->reserved)return 0;for(uint32_t d=0;d<16;d++){const z_dm_sound_t *p=&s->sound[d];if(p->level>127||p->decay<1||p->decay>127||p->tune< -24||p->tune>24||p->pan< -64||p->pan>63||p->mute>1||!p->length||p->length>64||p->reserved[0]||p->reserved[1])return 0;for(uint32_t at=0;at<64;at++){const z_dm_step_t *v=&s->step[d][at];if(v->velocity>127||v->chance>127||v->ratchet<1||v->ratchet>4)return 0;}}return 1;}
void z_dm_init(void){for(uint32_t i=0;i<sizeof z_dm;i++)((uint8_t*)&z_dm)[i]=0;z_dm.magic=Z_DM_MAGIC;z_dm.version=1;for(uint32_t d=0;d<16;d++){z_dm.sound[d].level=100;z_dm.sound[d].decay=64;z_dm.sound[d].length=32;for(uint32_t at=0;at<64;at++){z_dm.step[d][at].chance=127;z_dm.step[d][at].ratchet=1;}dm_voice[d].active=dm_left[d]=0;dm_wait[d]=dm_skip[d]=0;}dm_count=dm_keys=0;dm_rng=0x7a64c812u;z_dm_history_reset();}
void z_dm_migrate(void){z_dm_init();for(uint32_t d=0;d<16;d++)z_dm.sound[d].length=(uint8_t)z_get(5,Z_LENGTH);for(uint32_t at=0;at<64;at++){const z_step *s=&z_song.track[5].steps[at];if(!s->velocity)continue;for(uint32_t j=0;j<4;j++){uint32_t n=j?z_song.chord[5][at][j-1]:s->note+1;if(n){uint32_t d=z_drum_index(n-1);z_dm.step[d][at].velocity=s->velocity;z_dm.step[d][at].chance=s->chance;}}}}
uint32_t z_dm_size(void){return sizeof z_dm;}
uint32_t z_dm_snapshot(void){for(uint32_t i=0;i<sizeof z_dm;i++)transfer[i]=((const uint8_t*)&z_dm)[i];return (uint32_t)(uintptr_t)transfer;}
int z_dm_apply(uint32_t n){const z_dm_state *s=(const z_dm_state*)transfer;if(n!=sizeof z_dm||!z_dm_valid(s))return -1;z_dm=*s;z_dm_transport(0);z_dm_history_reset();z_touch();return 0;}
void z_dm_select(uint32_t d){if(d<16&&z_dm.selected!=d){z_dm.selected=(uint8_t)d;z_touch();}}
int z_dm_param(uint32_t d,uint32_t field,int32_t value){if(d>=16||field>5)return -1;static const int16_t lo[]={0,1,-24,-64,0,1},hi[]={127,127,24,63,1,64};if(value<lo[field]||value>hi[field])return -1;z_dm_sound_t *p=&z_dm.sound[d];dm_checkpoint();if(field==0)p->level=value;else if(field==1)p->decay=value;else if(field==2)p->tune=value;else if(field==3)p->pan=value;else if(field==4){p->mute=value;if(value){dm_voice[d].active=dm_left[d]=0;}}else p->length=value;z_touch();return 0;}
int z_dm_step(uint32_t d,uint32_t at,uint32_t vel,uint32_t chance,uint32_t ratchet){if(d>=16||at>=64||vel>127||chance>127||ratchet<1||ratchet>4)return -1;dm_checkpoint();z_dm.step[d][at]=(z_dm_step_t){vel,chance,ratchet};z_touch();return 0;}
static void dm_hit(uint32_t d,uint32_t velocity){if(d>=16||!velocity||z_dm.sound[d].mute||z_get(5,Z_MUTE)||(solo_track&&solo_track!=6))return;if(d==2||d==3){dm_voice[2].active=dm_voice[3].active=0;}voice *v=&dm_voice[d];v->track=5;v->drum=(uint8_t)d;v->phase=v->phase2=v->lp1=v->lp2=v->age=v->inc=0;v->env=1;v->velocity=(velocity>127?127:velocity)/127.0f;v->active=1;float ms=drum_ms[d]*(0.2f+z_dm.sound[d].decay/80.0f);v->drum_decay=1.0f-6.90776f/(ms*44.1f);}
void z_dm_key(uint32_t note,uint32_t velocity,uint32_t on){uint32_t d=z_drum_index(note),bit=1u<<d;if(on&&velocity){if(dm_keys&bit)return;dm_keys|=bit;z_dm_select(d);if(z_song.recording){uint32_t len=z_dm.sound[d].length,at=playing?(dm_count?dm_count-1:0)%len:z_song.step_edit%len,ahead=playing&&!dm_count;if(playing&&dm_count&&!z_song.rec_quant&&(audio_frame-last_step_frame)>=step_frames()*(1+((pos&1)?-1:1)*z_song.swing/200.0f)*0.5f){at=(at+1)%len;ahead=1;}z_dm.step[d][at].velocity=(uint8_t)(velocity>127?127:velocity);z_dm.step[d][at].chance=127;z_touch();z_song.step_edit=at;z_song.step_bank=at/16;if(ahead)dm_skip[d]=dm_count+1;}dm_hit(d,velocity);}else{if(!(dm_keys&bit))return;dm_keys&=~bit;if(z_song.recording&&!playing&&!dm_keys){z_song.step_edit=(z_song.step_edit+1)%z_dm.sound[z_dm.selected].length;z_song.step_bank=z_song.step_edit/16;z_touch();}}}
void z_dm_transport(uint32_t on){dm_count=0;dm_keys=0;for(uint32_t d=0;d<16;d++){dm_left[d]=0;dm_wait[d]=dm_skip[d]=0;if(!on)dm_voice[d].active=0;}}
void z_dm_songpos(uint32_t at){dm_count=at;for(uint32_t d=0;d<16;d++)dm_left[d]=0;}
uint32_t z_dm_position(uint32_t d){return d<16?(dm_count?dm_count-1:0)%z_dm.sound[d].length:0;}
static void dm_seqhit(uint32_t d,uint32_t velocity){dm_hit(d,velocity);if(midi_out&&!z_dm.sound[d].mute&&!z_get(5,Z_MUTE)&&(!solo_track||solo_track==6))midi_out(5,z_drum_note(d),velocity,25);}
void z_dm_clock(void){for(uint32_t d=0;d<16;d++){z_dm_step_t *s=&z_dm.step[d][dm_count%z_dm.sound[d].length];dm_left[d]=0;if(!s->velocity||z_dm.sound[d].mute||dm_skip[d]==dm_count+1)continue;if((s->chance<127&&(dm_random()&127)>=s->chance)||(z_get(5,Z_PROBABILITY)<127&&(dm_random()&127)>=(uint32_t)z_get(5,Z_PROBABILITY)))continue;dm_seqhit(d,s->velocity);dm_velocity[d]=s->velocity;dm_left[d]=s->ratchet-1;float span=step_frames()*(1+((pos&1)?-1:1)*z_song.swing/200.0f);dm_period[d]=(uint32_t)(span/s->ratchet);dm_wait[d]=dm_period[d];}dm_count++;}
void z_dm_audio(float *l,float *r,float *sd,float *sr,float cutoff){const int16_t *p=z_song.track[5].p;for(uint32_t d=0;d<16;d++){if(dm_left[d]){if(dm_wait[d])dm_wait[d]--;else{dm_seqhit(d,dm_velocity[d]);dm_left[d]--;dm_wait[d]=dm_period[d]?dm_period[d]-1:0;}}voice *v=&dm_voice[d];if(!v->active)continue;v->age+=1.0f/44100;v->env*=v->drum_decay;if(v->env<0.00008f){v->active=0;continue;}float x=drum_signal(v);x=clampf(x-v->lp2*p[Z_RESONANCE]/100.0f,-3,3);v->lp1+=(x-v->lp1)*cutoff;v->lp2+=(v->lp1-v->lp2)*cutoff;x=sat(v->lp2*(1+p[Z_DRIVE]/20.0f))*1.4f*v->env*v->velocity*p[Z_LEVEL]/127.0f*z_dm.sound[d].level/100.0f*.5f;if(p[Z_MUTE]||z_dm.sound[d].mute||(solo_track&&solo_track!=6))x=0;float pan=clampf((p[Z_PAN]+z_dm.sound[d].pan)/128.0f,-.5f,.5f);*l+=x*(.5f-pan);*r+=x*(.5f+pan);*sd+=x*p[Z_DELAY]/127.0f;*sr+=x*p[Z_REVERB]/127.0f;}}

void z_dm_panic(void){dm_keys=0;for(uint32_t d=0;d<16;d++){dm_voice[d].active=dm_left[d]=0;dm_skip[d]=0;}}
int z_dm_pattern(uint32_t action){if(action>6||action==4)return -1;if(!action)return z_erase(5,0,1);uint32_t d=z_dm.selected,len=z_dm.sound[d].length;if(action==1&&len>32)return -1;dm_checkpoint();z_dm_step_t *s=z_dm.step[d],v;if(action==1){for(uint32_t i=0;i<len;i++)s[len+i]=s[i];z_dm.sound[d].length=len*2;}else if(action==5){for(uint32_t i=0;i<len/2;i++){v=s[i];s[i]=s[len-1-i];s[len-1-i]=v;}}else if(action==6){for(uint32_t i=0;i<len;i++)s[i]=(z_dm_step_t){(i%(d==0?4:d==1?8:2)==(d==1?4:0))?100:0,127,1};}else{v=s[action==2?0:len-1];for(uint32_t i=0;i<len-1;i++)s[action==2?i:len-1-i]=s[action==2?i+1:len-2-i];s[action==2?len-1:0]=v;}z_touch();return 0;}

uint32_t z_dm_data(void){return (uint32_t)(uintptr_t)&z_dm;}

void z_dm_checkpoint(void){dm_checkpoint();}

int z_dm_erase(uint32_t at,uint32_t scope){if(at>=64||scope>2)return -1;dm_checkpoint();uint32_t first=scope==2?0:z_dm.selected,last=scope==2?16:first+1;for(uint32_t d=first;d<last;d++){dm_voice[d].active=dm_left[d]=0;dm_skip[d]=0;for(uint32_t i=scope?0:at;i<(scope?64:at+1);i++)z_dm.step[d][i]=(z_dm_step_t){0,127,1};}z_touch();return 0;}
